# El TLS lo termina el proxy que está adelante (host).
# Este contenedor sirve HTTP plano en el 80, publicado en el host como 8000.
# Por eso la dirección es `:80` sin dominio: así Caddy no intenta pedir certificados.

:80 {
	encode zstd gzip

	root * /srv

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Assets con hash: cache larga
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# www -> apex
	@www host www.fullware.com.ar
	redir @www https://fullware.com.ar{uri} permanent

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors {
		@notfound expression {http.error.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
		respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}
}
