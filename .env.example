# Fullware — variables de entorno
# Copiá este archivo a .env y completá los valores reales. .env nunca se commitea.

# — Sitio (públicas, se inlinean en el build)
PUBLIC_SITE_URL=https://fullware.com.ar
PUBLIC_WHATSAPP_NUMBER=549XXXXXXXXXX
PUBLIC_CONTACT_EMAIL=tu-mail@fullware.com.ar

# — WAHA (avisos de consultas)
WAHA_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_NOTIFY_CHAT_ID=549XXXXXXXXXX@c.us

# — Telegram (avisos de consultas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# — SOFI (proveedor compatible OpenAI)
SOFI_API_URL=https://integrate.api.nvidia.com/v1
SOFI_API_KEY=
SOFI_MODEL=nvidia/nemotron-3.5-bolt-e4b
SOFI_DAILY_GLOBAL_CAP=200
SOFI_TEMPERATURE=0.4
SOFI_MAX_TOKENS=300

# — Cloudflare Email Worker (reenvío de mails)
MAIL_WORKER_URL=
MAIL_WORKER_TOKEN=
MAIL_WORKER_TO=

# — Seguridad
IP_HASH_SALT=cambiar-por-un-string-largo
SOFI_COOKIE_SECRET=cambiar-por-otro-string-largo
