---
import Base from '../../layouts/Base.astro'
---

<Base
  title="Blog | Fullware"
  description="Notas sobre automatización, IA, servidores y aprendizajes desde el blog oficial."
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-6">
      <p class="section-label">blog</p>
      <h1 class="mt-4 text-3xl font-medium sm:text-4xl">Notas de campo</h1>
      <p class="mt-3 max-w-2xl text-base text-muted">
        Automatización, IA, servidores propios y aprendizajes. Sincronizado con
        <a href="https://blog.fullware.com.ar/" class="text-neon hover:underline">blog.fullware.com.ar</a>.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-12 sm:px-6">
    <div id="blog-list" class="grid gap-4 md:grid-cols-2" aria-live="polite">
      <article class="rounded-lg border border-line bg-surface p-6">
        <p class="font-mono text-xs text-muted">Cargando notas...</p>
      </article>
    </div>

    <div id="blog-empty" class="hidden rounded-lg border border-line bg-surface p-6 text-center">
      <p class="text-sm text-muted">No se pudieron cargar las notas en este momento.</p>
      <a
        href="https://blog.fullware.com.ar/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex btn btn-primary"
      >
        Ir al blog oficial
      </a>
    </div>

    <div class="mt-10 text-center">
      <a
        href="https://blog.fullware.com.ar/"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-quiet"
      >
        Ver todos los posts en el blog oficial →
      </a>
    </div>
  </section>

  <script>
    async function loadBlog() {
      const list = document.getElementById('blog-list')
      const empty = document.getElementById('blog-empty')
      if (!list) return

      try {
        const res = await fetch('/api/blog/feed', { cache: 'no-store' })
        if (!res.ok) throw new Error('fallo')
        const xml = await res.text()
        const items = xml.match(/<item>[\s\S]*?<\/item>/g) || []

        if (items.length === 0) {
          list.innerHTML = ''
          empty?.classList.remove('hidden')
          return
        }

        list.innerHTML = items
          .slice(0, 20)
          .map((item) => {
            const titleMatch = item.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>|<title>(.*?)<\/title>/)
            const title = titleMatch?.[1] || titleMatch?.[2] || ''
            const link = item.match(/<link>(.*?)<\/link>/)?.[1] || ''
            const pubDate = item.match(/<pubDate>(.*?)<\/pubDate>/)?.[1] || ''
            const descMatch = item.match(/<description><!\[CDATA\[(.*?)\]\]><\/description>|<description>(.*?)<\/description>/s)
            const description = descMatch?.[1] || descMatch?.[2] || ''

            const date = pubDate ? new Date(pubDate).toLocaleDateString('es-AR') : ''

            return `
              <article class="group rounded-lg border border-line bg-surface transition-colors hover:border-neon/50">
                <a href="${link}" target="_blank" rel="noopener noreferrer" class="block p-6">
                  <div class="flex items-center justify-between gap-4">
                    <time class="font-mono text-[11px] uppercase tracking-widest text-muted">${date}</time>
                    <span class="font-mono text-[11px] text-neon">↗</span>
                  </div>
                  <h2 class="mt-3 text-lg font-medium group-hover:text-neon">${title.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</h2>
                  <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">${description.replace(/<[^>]+>/g, '')}</p>
                </a>
              </article>
            `
          })
          .join('')
      } catch (e) {
        list.innerHTML = ''
        empty?.classList.remove('hidden')
      }
    }

    loadBlog()
  </script>
</Base>
