---
import Base from '../../layouts/Base.astro'
export function getStaticPaths() {
  return []
}
---

<Base title="Blog | Fullware" description="Redirigiendo al blog oficial de Fullware.">
  <meta http-equiv="refresh" content="0; url=https://blog.fullware.com.ar/" />
  <section class="mx-auto max-w-3xl px-5 py-24 text-center sm:px-6">
    <p class="section-label">blog</p>
    <h1 class="mt-4 text-2xl font-medium sm:text-3xl">Te redirigimos al blog oficial</h1>
    <p class="mt-3 text-sm text-muted">
      Si no se redirige automáticamente,
      <a href="https://blog.fullware.com.ar/" class="text-neon underline decoration-neon/40 underline-offset-4 hover:decoration-neon">
        hacé clic acá
      </a>
      .
    </p>
  </section>
</Base>
