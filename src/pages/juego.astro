---
import Base from '../layouts/Base.astro'

const solitaireUrl = 'https://solitario.fullware.com.ar/'
---

<Base
  title="Solitario"
  description="Solitario Klondike jugable. Un pequeño espacio para cortar un rato."
  noindex
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-5 pb-8 pt-14 sm:px-6 sm:pt-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="section-label">~/juego</p>
          <h1 class="mt-4 text-3xl font-medium sm:text-4xl">Solitario.</h1>
          <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted">
            Un Klondike para cortar un rato. Si algo se puede jugar bien en la web, también se puede
            construir a medida.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href={solitaireUrl} target="_blank" rel="noopener noreferrer" class="btn btn-quiet">
            Abrir aparte
          </a>
          <a href="/" class="btn btn-quiet">← Volver</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="overflow-hidden rounded-lg border border-line bg-surface">
      <iframe
        src={solitaireUrl}
        title="Solitario Klondike"
        class="h-[72dvh] min-h-[560px] w-full border-0 bg-bg sm:min-h-[680px]"
        loading="lazy"
        allow="fullscreen"
      ></iframe>
    </div>
  </section>
</Base>
