---
import Base from '../layouts/Base.astro'
import Solitaire from '../components/islands/Solitaire.tsx'
---

<Base
  title="Solitario"
  description="Solitario Klondike jugable, hecho desde cero. Un pequeño demo de lo que se puede construir."
  noindex
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-5 pb-8 pt-14 sm:px-6 sm:pt-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="section-label">~/juego</p>
          <h1 class="mt-4 text-3xl font-medium sm:text-4xl">Solitario.</h1>
          <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted">
            Klondike completo: baraja, descarte, fundaciones y siete columnas. Hecho desde cero, sin
            librerías de juego. Un recordatorio de que si se puede jugar, también se puede automatizar.
          </p>
        </div>
        <a href="/" class="btn btn-quiet">← Volver</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Solitaire client:only="react" />
  </section>
</Base>
