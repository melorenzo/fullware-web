---
import { site, navLinks, whatsappLink, mailtoLink } from '../data/site'

const year = new Date().getFullYear()
---

<footer class="border-t border-line bg-bg">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-6 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex items-baseline font-mono text-lg font-bold" aria-label="Fullware, ir al inicio">
        <span>FULLWARE</span><span class="cursor-blink text-neon">_</span>
      </a>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">
        Automatización, agentes de IA y servidores propios. Soluciones a medida, sin humo.
      </p>
      <p class="mt-4 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-neon" aria-hidden="true"></span>
        sistemas operativos
      </p>
    </div>

    <nav aria-label="Navegación del pie">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-text">Navegación</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-muted transition-colors hover:text-neon">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/matias" class="text-muted transition-colors hover:text-neon">
            Matías Lorenzo
          </a>
        </li>
      </ul>
    </nav>

    <div>
      <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-text">Contacto</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li>
          <a
            href={whatsappLink()}
            class="text-muted transition-colors hover:text-neon"
            target={whatsappLink().startsWith('http') ? '_blank' : undefined}
            rel="noopener noreferrer"
          >
            WhatsApp
          </a>
        </li>
        <li>
          <a href={mailtoLink()} class="break-all text-muted transition-colors hover:text-neon">
            {site.email || 'TODO: mail de contacto'}
          </a>
        </li>
        <li class="pt-1 font-mono text-[11px] text-muted">{site.location}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-5 font-mono text-[11px] text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {year} Fullware. Todos los derechos reservados.</p>
      <p class="flex items-center gap-2">
        <span aria-hidden="true">~/</span>
        <span>hecho con Astro, Docker y criterio</span>
      </p>
    </div>
  </div>
</footer>
