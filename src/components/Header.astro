---
import { navLinks, whatsappLink } from '../data/site'
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-6">
    <a
      href="/"
      class="logo-glitch inline-flex items-baseline font-mono text-lg font-bold tracking-tight"
      aria-label="Fullware, ir al inicio"
    >
      <span class="logo-text">FULLWARE</span><span class="cursor-blink text-neon">_</span>
    </a>

    <nav class="hidden items-center gap-7 font-mono text-[11px] uppercase tracking-[0.18em] text-muted md:flex">
      {
        navLinks.map((link) => (
          <a href={link.href} class="transition-colors hover:text-neon">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        id="palette-trigger"
        class="hidden items-center gap-1.5 rounded-md border border-line bg-surface px-2.5 py-1.5 font-mono text-[11px] text-muted transition-colors hover:border-neon hover:text-neon sm:inline-flex"
        aria-label="Abrir paleta de comandos"
      >
        <span aria-hidden="true">Ctrl</span>
        <span aria-hidden="true" class="text-neon">K</span>
      </button>

      <a
        href={whatsappLink()}
        class="btn btn-primary hidden sm:inline-flex"
        target={whatsappLink().startsWith('http') ? '_blank' : undefined}
        rel="noopener noreferrer"
      >
        WhatsApp
      </a>

      <details class="relative md:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-line bg-surface text-text transition-colors hover:border-neon hover:text-neon [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">Abrir menú</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </summary>

        <div class="absolute right-0 top-full mt-2 w-60 rounded-lg border border-line bg-surface p-2 shadow-xl">
          <nav class="flex flex-col" aria-label="Navegación principal">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class="rounded px-3 py-2.5 font-mono text-xs uppercase tracking-widest text-muted transition-colors hover:bg-bg hover:text-neon"
                >
                  {link.label}
                </a>
              ))
            }
            <a
              href="/matias"
              class="rounded px-3 py-2.5 font-mono text-xs uppercase tracking-widest text-muted transition-colors hover:bg-bg hover:text-neon"
            >
              Matías
            </a>
          </nav>
          <div class="mt-2 flex flex-col gap-2 border-t border-line p-2 pt-3">
            <a
              href={whatsappLink()}
              class="btn btn-primary w-full"
              target={whatsappLink().startsWith('http') ? '_blank' : undefined}
              rel="noopener noreferrer"
            >
              WhatsApp
            </a>
            <button
              type="button"
              id="palette-trigger-mobile"
              class="btn btn-quiet w-full"
            >
              Buscar (Ctrl K)
            </button>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  function openPalette() {
    window.dispatchEvent(new CustomEvent('fullware:palette'))
  }

  document.getElementById('palette-trigger')?.addEventListener('click', openPalette)
  document.getElementById('palette-trigger-mobile')?.addEventListener('click', openPalette)
</script>
