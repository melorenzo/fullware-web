---
import type { Status } from '../data/projects'

interface Props {
  status: Status
  class?: string
}

const { status, class: className = '' } = Astro.props

const meta: Record<Status, { label: string; dot: string; text: string; pulse?: boolean }> = {
  online: { label: 'online', dot: 'bg-neon', text: 'text-neon' },
  jugable: { label: 'jugable', dot: 'bg-neon', text: 'text-neon' },
  beta: { label: 'beta', dot: 'bg-orange', text: 'text-orange' },
  demo: { label: 'demo', dot: 'bg-orange', text: 'text-orange' },
  construccion: { label: 'en construcción', dot: 'bg-muted', text: 'text-muted', pulse: true },
}

const current = meta[status]
---

<span
  class:list={[
    'inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest',
    current.text,
    className,
  ]}
>
  <span
    class:list={['h-1.5 w-1.5 rounded-full', current.dot, current.pulse && 'status-pulse']}
    aria-hidden="true"
  ></span>
  {current.label}
</span>
