---
import type { Service } from '../data/services'

interface Props {
  service: Service
  index: number
}

const { service, index } = Astro.props
const number = String(index + 1).padStart(2, '0')
---

<article class="card group flex flex-col p-6 hover:border-neon/40">
  <div class="flex items-start justify-between gap-3">
    <span class="font-mono text-[11px] tracking-widest text-muted" aria-hidden="true">{number}</span>
    <span
      class="rounded border border-line px-1.5 py-0.5 font-mono text-[10px] tracking-widest text-orange"
      aria-hidden="true">{service.glyph}</span
    >
  </div>

  <h3 class="mt-5 text-lg font-medium text-text">{service.title}</h3>
  <p class="mt-2.5 text-sm leading-relaxed text-muted">{service.summary}</p>

  <ul class="mt-5 space-y-1.5 border-t border-line pt-4 font-mono text-[11px] text-muted">
    {
      service.bullets.map((bullet) => (
        <li class="flex items-start gap-2">
          <span class="mt-0.5 text-neon" aria-hidden="true">
            +
          </span>
          {bullet}
        </li>
      ))
    }
  </ul>
</article>
